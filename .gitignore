# Build output & deps
node_modules/
dist/
.astro/
*.log

# OS / editor cruft
.DS_Store

# Transient SQLite journal
data/*.db-journal

# Local secrets (Supabase keys). .env.example is committed as a template.
.env
.env.local

# Build artifacts derived from Postgres by scripts/export_sqlite.mjs on every
# prebuild and shipped via dist/. Not committed — Postgres is the source of
# truth and these regenerate on every build (committing them is pure churn).
# (movies_web.db is no longer read at runtime since /query moved to Supabase.)
public/downloads/
public/movies_web.db
export/films_full.csv

# TMDB match output (scripts/tmdb_match.py) — reproducible from the API and large;
# the enrichment it feeds lives in Postgres (movie_tmdb), the source of truth.
tmdb_matches.csv

# Raw source archive (167 MB of original .shtml pages, a–z). This is the
# provenance for movies_web.db but is NOT used by the site or the build, so it
# is kept out of the deploy repo to keep clones and CI checkouts fast.
# Remove this line if you want the raw archive tracked in git too.
source-archive/

# NOTE: public/movies_web.db, export/films.json, and package-lock.json are
# intentionally NOT ignored — they are required to build and deploy the site.
