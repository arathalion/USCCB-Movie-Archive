# Base URL of the Cloudflare Worker API (worker/). Astro inlines PUBLIC_* vars
# into the browser bundle — used by the browse page's full-text search, the
# /query SQL editor, and the /submit form.
#
# Local development: run `npx wrangler dev --local` inside worker/ and leave this
# as-is. In CI, set PUBLIC_API_BASE to the deployed Worker URL, e.g.
# https://movie-archive-api.<subdomain>.workers.dev
PUBLIC_API_BASE=https://movie-archive-api.viacrusis14.workers.dev

# Cloudflare Turnstile site key (public — exposed to the browser on /submit).
# Default below is Cloudflare's "always passes" TEST key; replace with a real
# site key from dash.cloudflare.com → Turnstile for production. The matching
# SECRET key is set on the Worker, not here:
#   cd worker && npx wrangler secret put TURNSTILE_SECRET
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# NOTE: the site no longer reads from Supabase. Page data is built from the
# NDJSON dumps in data/ and the live API is the Worker in worker/. The old
# free-tier project kept pausing even with a working keep-alive, so it was
# retired. scripts/dump_from_postgres.mjs and scripts/import_to_postgres.mjs are
# kept for provenance and need SUPABASE_URL / SUPABASE_ANON_KEY /
# SUPABASE_SERVICE_ROLE_KEY set ad hoc if you ever run them again.
