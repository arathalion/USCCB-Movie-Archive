# Supabase connection for the build (public values — safe to expose in client/CI).
SUPABASE_URL=https://vjtavurzjxfjczpvtpdq.supabase.co
SUPABASE_ANON_KEY=sb_publishable_MnMcji0ZPqJZPTn911Sg1A_KCzvBVO3

# PUBLIC_ copies are exposed to the browser (Astro inlines PUBLIC_* into the
# client bundle). Used by the /query page to read live data via PostgREST.
PUBLIC_SUPABASE_URL=https://vjtavurzjxfjczpvtpdq.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_MnMcji0ZPqJZPTn911Sg1A_KCzvBVO3

# Cloudflare Turnstile site key (public — exposed to the browser on /submit).
# Default below is Cloudflare's "always passes" TEST key; replace with a real
# site key from dash.cloudflare.com → Turnstile for production. The matching
# SECRET key is NOT set here — it's an Edge Function secret (TURNSTILE_SECRET).
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Service-role key — SECRET. Used ONLY by scripts/import_to_postgres.mjs for the
# one-time data load (bypasses RLS). Never commit this and never ship it to the client.
# Find it in: Supabase Dashboard → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=
