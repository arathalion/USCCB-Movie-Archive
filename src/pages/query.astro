---
import Base from '../layouts/Base.astro';

// Examples target the Postgres `movies` table (the canonical source). They run
// server-side via the read-only run_read_only_sql() function.
const EXAMPLES = [
  "select usccb_code, count(*) as n from movies group by usccb_code order by n desc;",
  "select title, year from movies where usccb_code = 'O' and year between 2000 and 2010 order by year;",
  "select mpaa_rating, count(*) as n from movies where mpaa_rating is not null group by 1 order by n desc;",
  "select title, year from movies where search_tsv @@ websearch_to_tsquery('english', 'vampire') order by year;",
];
const DEFAULT_QUERY = EXAMPLES[0];
---

<Base title="SQL" description="Run read-only SQL against the USCCB movie archive (Postgres)." active="query">
  <h1>SQL query</h1>
  <p class="lede">
    Run read-only SQL directly against the live archive database. A single
    <code>SELECT</code> or <code>WITH</code> only — queries run with a 5-second timeout
    and return up to 1,000 rows.
  </p>

  <textarea id="sql" class="sql-editor" spellcheck="false">{DEFAULT_QUERY}</textarea>
  <div class="toolbar">
    <button id="run">Run</button>
    <button id="csv" class="secondary" disabled>Download CSV</button>
    <button id="json" class="secondary" disabled>Download JSON</button>
    <span class="note" id="status">Ready.</span>
  </div>
  <div id="error" class="error" hidden></div>
  <div class="results-wrap" id="resultsWrap" hidden><table class="results" id="results"></table></div>

  <h2>Example queries</h2>
  <p class="note">Click to load into the editor.</p>
  {EXAMPLES.map((ex) => <pre class="example">{ex}</pre>)}

  <details class="schema">
    <summary>Schema &amp; rating reference</summary>
    <p><strong>Table <code>movies</code></strong> — one row per film (13,205 real films):</p>
    <dl class="dl-list">
      <dt>id, slug</dt><dd>integer primary key; <code>slug</code> is the URL key.</dd>
      <dt>title, year</dt><dd>year is nullable (~3.6%).</dd>
      <dt>usccb_code</dt><dd>USCCB rating: A-I, A-II, A-III, A-IV, L, O (nullable). FK to <code>usccb_ratings</code>.</dd>
      <dt>mpaa_rating</dt><dd>G / PG / PG-13 / R / NC-17 … (nullable, ~42%).</dd>
      <dt>synopsis, full_review</dt><dd>capsule; long review (1,619 films, paragraphs split by blank lines).</dd>
      <dt>letter, source_file</dt><dd>source folder (a–z) and original archive path.</dd>
    </dl>
    <p><code>movies</code> holds only real films now; the 330 “see other title” alias stubs live
      in a separate <code>redirects</code> table, and TMDB data is in <code>movie_tmdb</code> (join on
      <code>movie_id</code>).</p>
    <p><strong>Full-text search</strong> uses a Postgres <code>tsvector</code> column <code>search_tsv</code>
      (title + synopsis + full_review):</p>
    <pre class="example">select title, year from movies
where search_tsv @@ websearch_to_tsquery('english', 'redemption')
order by year;</pre>
    <p><strong>Other tables:</strong> <code>usccb_ratings</code> (code, label, description, sort_order),
      <code>movie_tmdb</code> (movie_id, tmdb_id, poster_path, overview…),
      <code>genres</code> (id, name) + <code>movie_genres</code> (movie_id, genre_id),
      <code>redirects</code> (slug, title, target_title, target_movie_id).</p>
    <p><strong>USCCB legend:</strong> A-I general patronage · A-II adults and adolescents ·
      A-III adults · A-IV adults with reservations · L limited adult audience · O morally offensive.</p>
  </details>
</Base>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );
  const RENDER_CAP = 1000;

  const sqlEl = document.getElementById('sql');
  const runEl = document.getElementById('run');
  const csvEl = document.getElementById('csv');
  const jsonEl = document.getElementById('json');
  const statusEl = document.getElementById('status');
  const errorEl = document.getElementById('error');
  const wrapEl = document.getElementById('resultsWrap');
  const tableEl = document.getElementById('results');

  // Review text is untrusted → escape every rendered cell (XSS guard).
  const esc = (s) =>
    String(s ?? '').replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  // Light client-side check for fast feedback; the server enforces the real rules.
  function clientGuard(raw) {
    const sql = raw.trim().replace(/;\s*$/, '');
    if (!sql) throw new Error('Enter a query.');
    if (sql.includes(';')) throw new Error('Only a single statement is allowed (remove extra ";").');
    if (!/^\s*(select|with)\b/i.test(sql)) throw new Error('Only SELECT / WITH queries are allowed.');
    return sql;
  }

  let lastCols = [], lastRows = [];

  async function run() {
    errorEl.hidden = true;
    let sql;
    try { sql = clientGuard(sqlEl.value); }
    catch (e) { errorEl.hidden = false; errorEl.textContent = e.message; return; }

    runEl.disabled = true;
    csvEl.disabled = jsonEl.disabled = true;
    statusEl.textContent = 'Running…';
    const t0 = performance.now();
    try {
      const { data, error } = await supabase.rpc('run_read_only_sql', { query: sql });
      if (error) throw new Error(error.message);
      const rows = data || [];
      const ms = Math.round(performance.now() - t0);
      lastRows = rows;
      lastCols = rows.length ? Object.keys(rows[0]) : [];
      renderTable(lastCols, rows);
      statusEl.textContent =
        `${rows.length.toLocaleString()} row${rows.length === 1 ? '' : 's'} in ${ms} ms` +
        (rows.length >= RENDER_CAP ? ` (capped at ${RENDER_CAP.toLocaleString()})` : '');
      csvEl.disabled = jsonEl.disabled = rows.length === 0;
    } catch (e) {
      errorEl.hidden = false;
      errorEl.textContent = e && e.message ? e.message : String(e);
      statusEl.textContent = 'Error.';
    } finally {
      runEl.disabled = false;
    }
  }

  function renderTable(cols, rows) {
    wrapEl.hidden = false;
    if (!rows.length) { tableEl.innerHTML = '<tr><td>No rows.</td></tr>'; return; }
    const head = '<thead><tr>' + cols.map((c) => `<th>${esc(c)}</th>`).join('') + '</tr></thead>';
    const body = rows.map((r) =>
      '<tr>' + cols.map((c) => `<td>${esc(r[c])}</td>`).join('') + '</tr>'
    ).join('');
    tableEl.innerHTML = head + '<tbody>' + body + '</tbody>';
  }

  function toCSV(cols, rows) {
    const cell = (v) => {
      const s = v == null ? '' : typeof v === 'object' ? JSON.stringify(v) : String(v);
      return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
    };
    return [cols.join(','), ...rows.map((r) => cols.map((c) => cell(r[c])).join(','))].join('\n');
  }
  function download(name, text, type) {
    const blob = new Blob([text], { type });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = name;
    a.click();
    URL.revokeObjectURL(a.href);
  }

  runEl.addEventListener('click', run);
  sqlEl.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') { e.preventDefault(); run(); }
  });
  csvEl.addEventListener('click', () => download('query.csv', toCSV(lastCols, lastRows), 'text/csv'));
  jsonEl.addEventListener('click', () => download('query.json', JSON.stringify(lastRows, null, 2), 'application/json'));
  document.querySelectorAll('pre.example').forEach((pre) =>
    pre.addEventListener('click', () => { sqlEl.value = pre.textContent.trim(); sqlEl.focus(); })
  );

  run();
</script>
