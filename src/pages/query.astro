---
import Base from '../layouts/Base.astro';
import { USCCB_ORDER, USCCB_LEGEND } from '../lib/ratings.js';

// Common MPAA values present in the archive (older ratings exist but these cover
// the bulk; leave "All" to ignore the filter).
const MPAA = ['G', 'PG', 'PG-13', 'R', 'NC-17'];
const CAP = 1000;
---

<Base title="Query" description="Search and filter the USCCB movie archive — live, against the database." active="query">
  <h1>Query the archive</h1>
  <p class="lede">
    Full-text search and structured filters over all 13,694 reviews, run live against
    the database. Results are capped at {CAP.toLocaleString()} rows; export what you find as CSV or JSON.
  </p>

  <div class="controls">
    <input
      type="search"
      id="q"
      placeholder="Full-text search — title, synopsis, full review (e.g. vampire, redemption)…"
      autocomplete="off"
      spellcheck="false"
    />
    <div class="filters">
      <select id="usccb" aria-label="USCCB rating">
        <option value="">All USCCB ratings</option>
        {USCCB_ORDER.map((r) => <option value={r}>{r} — {USCCB_LEGEND[r]}</option>)}
      </select>
      <select id="mpaa" aria-label="MPAA rating">
        <option value="">All MPAA ratings</option>
        {MPAA.map((m) => <option value={m}>{m}</option>)}
      </select>
      <input type="number" id="ymin" class="year-in" placeholder="Year from" aria-label="Year from" />
      <input type="number" id="ymax" class="year-in" placeholder="Year to" aria-label="Year to" />
      <select id="sort" aria-label="Sort by">
        <option value="title:asc">Title (A–Z)</option>
        <option value="year:desc">Year (newest)</option>
        <option value="year:asc">Year (oldest)</option>
        <option value="usccb_code:asc">USCCB rating</option>
      </select>
      <label class="chk"><input type="checkbox" id="redirects" /> Include “see other title” stubs</label>
    </div>
  </div>

  <div class="toolbar">
    <button id="run">Run query</button>
    <button id="csv" class="secondary" disabled>Download CSV</button>
    <button id="json" class="secondary" disabled>Download JSON</button>
    <span class="note" id="status">Ready.</span>
  </div>
  <div id="error" class="error" hidden></div>
  <div class="results-wrap" id="resultsWrap" hidden><table class="results" id="results"></table></div>

  <details class="schema">
    <summary>What you can search &amp; filter</summary>
    <p><strong>Full-text search</strong> matches whole words (with stemming) across the
      <code>title</code>, <code>synopsis</code>, and <code>full_review</code> text. Supports
      <code>web search</code> style — quote <code>"exact phrases"</code>, use <code>or</code>, prefix
      with <code>-</code> to exclude.</p>
    <p><strong>Filters:</strong> USCCB rating (A-I … O), MPAA rating, and a year range.
      Redirect stubs (“see other title”) are excluded by default.</p>
    <p><strong>USCCB legend:</strong> A-I general patronage · A-II adults and adolescents ·
      A-III adults · A-IV adults with reservations · L limited adult audience · O morally offensive.</p>
  </details>
</Base>

<style>
  .controls .filters .year-in { width: 6.5rem; }
  .chk { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.88rem; color: var(--muted); }
  table.results td.title-cell a { font-weight: 500; }
  table.results td.synopsis-cell { max-width: 40ch; color: var(--muted); }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );
  const base = import.meta.env.BASE_URL;
  const CAP = 1000;

  const qEl = document.getElementById('q');
  const usccbEl = document.getElementById('usccb');
  const mpaaEl = document.getElementById('mpaa');
  const yminEl = document.getElementById('ymin');
  const ymaxEl = document.getElementById('ymax');
  const sortEl = document.getElementById('sort');
  const redirectsEl = document.getElementById('redirects');
  const runEl = document.getElementById('run');
  const csvEl = document.getElementById('csv');
  const jsonEl = document.getElementById('json');
  const statusEl = document.getElementById('status');
  const errorEl = document.getElementById('error');
  const wrapEl = document.getElementById('resultsWrap');
  const tableEl = document.getElementById('results');

  const USCCB_TT = {
    'A-I': 'General patronage', 'A-II': 'Adults and adolescents', 'A-III': 'Adults',
    'A-IV': 'Adults, with reservations', 'L': 'Limited adult audience', 'O': 'Morally offensive',
  };

  // Review text is untrusted → escape every rendered cell (XSS guard).
  const esc = (s) =>
    String(s ?? '').replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  const COLS = [
    { key: 'title', label: 'Title' },
    { key: 'year', label: 'Year' },
    { key: 'usccb_code', label: 'USCCB' },
    { key: 'mpaa_rating', label: 'MPAA' },
    { key: 'synopsis', label: 'Synopsis' },
  ];

  let lastRows = [];

  function buildQuery() {
    let q = supabase.from('movies').select('slug, title, year, usccb_code, mpaa_rating, synopsis');
    if (!redirectsEl.checked) q = q.eq('is_redirect', false);
    const text = qEl.value.trim();
    if (text) q = q.textSearch('search_tsv', text, { type: 'websearch', config: 'english' });
    if (usccbEl.value) q = q.eq('usccb_code', usccbEl.value);
    if (mpaaEl.value) q = q.eq('mpaa_rating', mpaaEl.value);
    if (yminEl.value) q = q.gte('year', Number(yminEl.value));
    if (ymaxEl.value) q = q.lte('year', Number(ymaxEl.value));
    const [col, dir] = sortEl.value.split(':');
    q = q.order(col, { ascending: dir === 'asc', nullsFirst: false });
    return q.limit(CAP);
  }

  async function run() {
    errorEl.hidden = true;
    runEl.disabled = true;
    csvEl.disabled = jsonEl.disabled = true;
    statusEl.textContent = 'Running…';
    const t0 = performance.now();
    try {
      const { data, error } = await buildQuery();
      if (error) throw error;
      const ms = Math.round(performance.now() - t0);
      lastRows = data;
      renderTable(data);
      statusEl.textContent =
        `${data.length.toLocaleString()} row${data.length === 1 ? '' : 's'} in ${ms} ms` +
        (data.length >= CAP ? ` (capped at ${CAP.toLocaleString()})` : '');
      csvEl.disabled = jsonEl.disabled = data.length === 0;
    } catch (e) {
      errorEl.hidden = false;
      errorEl.textContent = e && e.message ? e.message : String(e);
      statusEl.textContent = 'Error.';
    } finally {
      runEl.disabled = false;
    }
  }

  function renderTable(rows) {
    wrapEl.hidden = false;
    if (!rows.length) { tableEl.innerHTML = '<tr><td>No rows.</td></tr>'; return; }
    const head = '<thead><tr>' + COLS.map((c) => `<th>${esc(c.label)}</th>`).join('') + '</tr></thead>';
    const body = rows.map((r) => {
      const cells = [
        `<td class="title-cell"><a href="${base}film/${esc(r.slug)}">${esc(r.title)}</a></td>`,
        `<td>${r.year ?? '—'}</td>`,
        `<td>${r.usccb_code ? `<span class="chip usccb" title="${esc(USCCB_TT[r.usccb_code] || '')}">${esc(r.usccb_code)}</span>` : ''}</td>`,
        `<td>${r.mpaa_rating ? `<span class="chip">${esc(r.mpaa_rating)}</span>` : ''}</td>`,
        `<td class="synopsis-cell">${esc(r.synopsis)}</td>`,
      ];
      return '<tr>' + cells.join('') + '</tr>';
    }).join('');
    tableEl.innerHTML = head + '<tbody>' + body + '</tbody>';
  }

  function toCSV(rows) {
    const cell = (v) => {
      const s = v == null ? '' : String(v);
      return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
    };
    const keys = COLS.map((c) => c.key);
    return [keys.join(','), ...rows.map((r) => keys.map((k) => cell(r[k])).join(','))].join('\n');
  }
  function download(name, text, type) {
    const blob = new Blob([text], { type });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = name;
    a.click();
    URL.revokeObjectURL(a.href);
  }

  runEl.addEventListener('click', run);
  qEl.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); run(); } });
  [usccbEl, mpaaEl, sortEl].forEach((el) => el.addEventListener('change', run));
  csvEl.addEventListener('click', () => download('query.csv', toCSV(lastRows), 'text/csv'));
  jsonEl.addEventListener('click', () => download('query.json', JSON.stringify(lastRows, null, 2), 'application/json'));

  // Run once on load so visitors see results immediately.
  run();
</script>
