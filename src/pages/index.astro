---
import Base from '../layouts/Base.astro';
import { USCCB_ORDER, USCCB_LEGEND } from '../lib/ratings.js';
import { getGenres } from '../lib/db.js';

const MPAA = ['G', 'PG', 'PG-13', 'R', 'NC-17'];
const LETTERS = 'abcdefghijklmnopqrstuvwxyz'.split('');
const GENRES = await getGenres();
---

<Base title="Browse" description="Search and filter 13,205 USCCB / Catholic News Service movie reviews (1905–2011)." active="browse">
  <h1>Browse the archive</h1>
  <p class="lede">
    13,205 film reviews from the USCCB Office for Film &amp; Broadcasting / Catholic
    News Service, 1905–2011. Full-text search across reviews, filter by rating, genre, and year, sort any way.
  </p>

  <div class="controls">
    <input
      type="search"
      id="q"
      placeholder="Search titles &amp; reviews (e.g. vampire, redemption)…"
      autocomplete="off"
      spellcheck="false"
    />
    <div class="filters">
      <select id="usccb" aria-label="USCCB rating">
        <option value="">All USCCB ratings</option>
        {USCCB_ORDER.map((r) => <option value={r}>{r} — {USCCB_LEGEND[r]}</option>)}
      </select>
      <select id="mpaa" aria-label="MPAA rating">
        <option value="">All MPAA ratings</option>
        {MPAA.map((m) => <option value={m}>{m}</option>)}
      </select>
      <select id="genre" aria-label="Genre">
        <option value="">All genres</option>
        {GENRES.map((g) => <option value={g}>{g}</option>)}
      </select>
      <input type="number" id="ymin" class="year-in" placeholder="Year from" aria-label="Year from" />
      <input type="number" id="ymax" class="year-in" placeholder="Year to" aria-label="Year to" />
      <select id="sort" aria-label="Sort by">
        <option value="title:asc">Title (A–Z)</option>
        <option value="year:desc">Year (newest)</option>
        <option value="year:asc">Year (oldest)</option>
        <option value="usccb_code:asc">USCCB rating</option>
      </select>
    </div>
  </div>

  <nav class="az-bar" id="azBar" aria-label="Browse by letter">
    <button type="button" class="az" data-letter="">All</button>
    {LETTERS.map((l) => <button type="button" class="az" data-letter={l}>{l}</button>)}
  </nav>

  <div class="count-row">
    <p class="count" id="count">Loading…</p>
    <button type="button" id="reset" class="linkish" hidden>Clear filters</button>
  </div>
  <ul class="films" id="films"></ul>
  <div class="center">
    <button id="more" class="secondary" hidden>Show more</button>
  </div>
</Base>

<style>
  .controls .filters .year-in { width: 6.5rem; }

  .az-bar { display: flex; flex-wrap: wrap; gap: 0.25rem; margin: 0 0 1rem; }
  .az-bar .az {
    flex: 1 1 0; display: flex; align-items: center; justify-content: center;
    background: #fff; color: var(--ink); border: 1px solid var(--line);
    padding: 0.2rem 0.4rem; font-size: 0.8rem; border-radius: 4px;
    min-width: 1.6rem; text-transform: uppercase;
  }
  .az-bar .az:hover { background: var(--code-bg); }
  .az-bar .az.active { background: var(--ink); color: #fff; border-color: var(--ink); }

  .count-row { display: flex; align-items: baseline; gap: 0.75rem; }
  .linkish {
    background: none; border: none; color: var(--accent); padding: 0;
    font-size: 0.85rem; text-decoration: underline; cursor: pointer;
  }
  .linkish:hover { background: none; }
</style>

<script>
  // Browse runs against a static index (/browse-index.json, ~180 KB gzipped)
  // rather than a live database: filtering, sorting and paging 13,205 rows in
  // the browser is faster than a round-trip and keeps the homepage working even
  // if the API is down. Only full-text search needs the Worker, because ranked
  // search over the review text requires FTS5.
  import { apiGet } from '../lib/api.js';

  const base = import.meta.env.BASE_URL;
  const PAGE = 100;
  const SEARCH_CAP = 1000; // the API's documented per-response row cap
  const DEFAULT_SORT = 'title:asc';
  const SORTS = new Set(['title:asc', 'year:desc', 'year:asc', 'usccb_code:asc']);

  const USCCB_TT = {
    'A-I': 'General patronage', 'A-II': 'Adults and adolescents', 'A-III': 'Adults',
    'A-IV': 'Adults, with reservations', 'L': 'Limited adult audience', 'O': 'Morally offensive',
  };

  const esc = (s) =>
    String(s ?? '').replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  const qEl = document.getElementById('q');
  const usccbEl = document.getElementById('usccb');
  const mpaaEl = document.getElementById('mpaa');
  const genreEl = document.getElementById('genre');
  const yminEl = document.getElementById('ymin');
  const ymaxEl = document.getElementById('ymax');
  const sortEl = document.getElementById('sort');
  const countEl = document.getElementById('count');
  const listEl = document.getElementById('films');
  const moreEl = document.getElementById('more');
  const azBar = document.getElementById('azBar');
  const resetEl = document.getElementById('reset');

  let offset = 0, total = 0, loading = false;
  let letter = '';

  function hasFilters() {
    return !!(qEl.value.trim() || usccbEl.value || mpaaEl.value || genreEl.value || letter ||
      yminEl.value || ymaxEl.value || sortEl.value !== DEFAULT_SORT);
  }

  // ---- The static index ----
  // Wire format: { g: [genreName…], f: [[slug,title,year,usccb,mpaa,letter,[genreIdx…]]…] }
  const S = 0, T = 1, Y = 2, U = 3, M = 4, L = 5, G = 6;
  let INDEX = null;
  let indexPromise = null;

  function loadIndex() {
    if (!indexPromise) {
      indexPromise = fetch(`${base}browse-index.json`)
        .then((r) => {
          if (!r.ok) throw new Error(`browse index failed (${r.status})`);
          return r.json();
        })
        .then((d) => { INDEX = d; return d; });
    }
    return indexPromise;
  }

  // Full-text search is the one thing the local index can't do — it holds no
  // review text. Ask the Worker for matching slugs and intersect.
  async function searchSlugs(text) {
    const rows = await apiGet('movies', {
      select: 'slug',
      search_tsv: `wfts(english).${text}`,
      limit: String(SEARCH_CAP),
    });
    return new Set(rows.map((r) => r.slug));
  }

  const USCCB_RANK = { 'A-I': 1, 'A-II': 2, 'A-III': 3, 'A-IV': 4, L: 5, O: 6 };

  // Nulls always sort last, matching the old `nullsFirst: false` ordering.
  function comparator(key, dir) {
    const sign = dir === 'asc' ? 1 : -1;
    const byTitle = (a, b) => String(a[T]).localeCompare(String(b[T]));
    if (key === 'title') return (a, b) => sign * byTitle(a, b);
    if (key === 'year') {
      return (a, b) => {
        if (a[Y] == null && b[Y] == null) return byTitle(a, b);
        if (a[Y] == null) return 1;
        if (b[Y] == null) return -1;
        return sign * (a[Y] - b[Y]) || byTitle(a, b);
      };
    }
    return (a, b) => { // usccb_code
      const ra = USCCB_RANK[a[U]] ?? Infinity, rb = USCCB_RANK[b[U]] ?? Infinity;
      if (ra === Infinity && rb === Infinity) return byTitle(a, b);
      return sign * (ra - rb) || byTitle(a, b);
    };
  }

  function selectRows(slugSet) {
    const genreIdx = genreEl.value ? INDEX.g.indexOf(genreEl.value) : -1;
    const ymin = yminEl.value ? Number(yminEl.value) : null;
    const ymax = ymaxEl.value ? Number(ymaxEl.value) : null;

    const rows = INDEX.f.filter((r) => {
      if (slugSet && !slugSet.has(r[S])) return false;
      if (usccbEl.value && r[U] !== usccbEl.value) return false;
      if (mpaaEl.value && r[M] !== mpaaEl.value) return false;
      if (genreIdx !== -1 && !r[G].includes(genreIdx)) return false;
      if (letter && r[L] !== letter) return false;
      if (ymin !== null && (r[Y] == null || r[Y] < ymin)) return false;
      if (ymax !== null && (r[Y] == null || r[Y] > ymax)) return false;
      return true;
    });

    const [col, dir] = sortEl.value.split(':');
    return rows.sort(comparator(col, dir));
  }

  // ---- Shareable URL state (read on load / back-forward, write on every change) ----
  function syncUrl() {
    const p = new URLSearchParams();
    if (qEl.value.trim()) p.set('q', qEl.value.trim());
    if (usccbEl.value) p.set('usccb', usccbEl.value);
    if (mpaaEl.value) p.set('mpaa', mpaaEl.value);
    if (genreEl.value) p.set('genre', genreEl.value);
    if (letter) p.set('letter', letter);
    if (yminEl.value) p.set('ymin', yminEl.value);
    if (ymaxEl.value) p.set('ymax', ymaxEl.value);
    if (sortEl.value !== DEFAULT_SORT) p.set('sort', sortEl.value);
    const qs = p.toString();
    history.replaceState(null, '', qs ? `${location.pathname}?${qs}` : location.pathname);
  }

  function readUrl() {
    const p = new URLSearchParams(location.search);
    qEl.value = p.get('q') || '';
    usccbEl.value = p.get('usccb') || '';
    mpaaEl.value = p.get('mpaa') || '';
    genreEl.value = p.get('genre') || '';
    yminEl.value = p.get('ymin') || '';
    ymaxEl.value = p.get('ymax') || '';
    const s = p.get('sort') || DEFAULT_SORT;
    sortEl.value = SORTS.has(s) ? s : DEFAULT_SORT;
    letter = (p.get('letter') || '').toLowerCase();
    updateAz();
  }

  function updateAz() {
    azBar.querySelectorAll('.az').forEach((b) =>
      b.classList.toggle('active', (b.dataset.letter || '') === letter));
  }

  function rowHtml(r) {
    const usccb = r[U]
      ? `<span class="chip usccb" role="button" tabindex="0" data-usccb="${esc(r[U])}" ` +
        `title="Filter by ${esc(r[U])} — ${esc(USCCB_TT[r[U]] || '')}">${esc(r[U])}</span>`
      : '';
    const mpaa = r[M]
      ? `<span class="chip" role="button" tabindex="0" data-mpaa="${esc(r[M])}" ` +
        `title="Filter by ${esc(r[M])}">${esc(r[M])}</span>`
      : '';
    return `<li><span class="title"><a href="${base}film/${esc(r[S])}">${esc(r[T])}</a></span>` +
      `<span class="chip-row">${usccb}${mpaa}</span>` +
      `<span class="year">${r[Y] ?? '—'}</span></li>`;
  }

  let matches = [];   // current result set (whole thing, not a page)
  let truncated = false;

  async function load(reset) {
    if (loading) return;
    loading = true;
    try {
      if (reset) {
        offset = 0;
        listEl.innerHTML = '';
        countEl.textContent = 'Searching…';
        resetEl.hidden = !hasFilters();
        syncUrl();

        await loadIndex();
        const text = qEl.value.trim();
        let slugSet = null;
        if (text) {
          slugSet = await searchSlugs(text);
          truncated = slugSet.size >= SEARCH_CAP;
        } else {
          truncated = false;
        }
        matches = selectRows(slugSet);
        total = matches.length;
      }

      const slice = matches.slice(offset, offset + PAGE);
      listEl.insertAdjacentHTML('beforeend', slice.map(rowHtml).join(''));
      offset += slice.length;
      moreEl.hidden = offset >= total;
      countEl.textContent =
        `${total.toLocaleString()}${truncated ? '+' : ''} film${total === 1 ? '' : 's'}` +
        (offset < total ? ` — showing ${offset.toLocaleString()}` : '') +
        (truncated ? ` (search capped at ${SEARCH_CAP.toLocaleString()} matches)` : '');
    } catch (e) {
      countEl.textContent = qEl.value.trim()
        ? 'Search is unavailable right now — try clearing the search box to browse.'
        : 'Could not load the archive index.';
      console.error(e);
    } finally {
      loading = false;
    }
  }

  // ---- Clickable rating chips → set the matching filter ----
  function chipActivate(chip) {
    if (chip.dataset.usccb) usccbEl.value = chip.dataset.usccb;
    else if (chip.dataset.mpaa) mpaaEl.value = chip.dataset.mpaa;
    else return;
    load(true);
  }
  listEl.addEventListener('click', (e) => {
    const chip = e.target.closest('.chip');
    if (chip) chipActivate(chip);
  });
  listEl.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    const chip = e.target.closest('.chip');
    if (chip) { e.preventDefault(); chipActivate(chip); }
  });

  // ---- A–Z letter bar ----
  azBar.addEventListener('click', (e) => {
    const b = e.target.closest('.az');
    if (!b) return;
    letter = b.dataset.letter || '';
    updateAz();
    load(true);
  });

  // ---- Clear all filters ----
  resetEl.addEventListener('click', () => {
    qEl.value = usccbEl.value = mpaaEl.value = genreEl.value = yminEl.value = ymaxEl.value = '';
    sortEl.value = DEFAULT_SORT;
    letter = '';
    updateAz();
    load(true);
  });

  let t;
  const debounced = () => { clearTimeout(t); t = setTimeout(() => load(true), 200); };
  qEl.addEventListener('input', debounced);
  yminEl.addEventListener('input', debounced);
  ymaxEl.addEventListener('input', debounced);
  usccbEl.addEventListener('change', () => load(true));
  mpaaEl.addEventListener('change', () => load(true));
  genreEl.addEventListener('change', () => load(true));
  sortEl.addEventListener('change', () => load(true));
  moreEl.addEventListener('click', () => load(false));
  window.addEventListener('popstate', () => { readUrl(); load(true); });

  readUrl();
  load(true);
</script>
